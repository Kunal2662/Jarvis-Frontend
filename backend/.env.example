# JARVIS backend environment — copy to `.env` and fill in.
# `.env` is gitignored. Never commit real keys.

# LLM gateway API key. Required by backend/server.py.
# Outside the Emergent workspace, swap the LlmChat call for a direct provider
# SDK call and use that provider's key here instead. See README → Setup.
EMERGENT_LLM_KEY=

# Comma-separated allowed origins. Defaults to "*" when unset.
CORS_ORIGINS=http://localhost:3000
