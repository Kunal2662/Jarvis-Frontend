{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "Jarvis Design System",
    "version": "1.0.0",
    "description": "Master design tokens for Jarvis — AI Operating Companion. Dark-first, neutral graphite base with a single blue accent. Inspired by JARVIS, Windows 11 Fluent, VisionOS, Arc, Linear, Notion, Raycast.",
    "themePriority": "dark-first",
    "iconSystem": "lucide",
    "densityModel": "adaptive"
  },

  "color": {
    "primitive": {
      "graphite": {
        "0":  "#FFFFFF",
        "25": "#FBFCFD",
        "50": "#F5F7FA",
        "100": "#ECEFF3",
        "150": "#E1E6ED",
        "200": "#D3DAE3",
        "300": "#B4BECC",
        "400": "#8B96A6",
        "500": "#697485",
        "600": "#4E5867",
        "650": "#3E4653",
        "700": "#2E3542",
        "750": "#242A35",
        "800": "#1B202A",
        "850": "#151A22",
        "900": "#0F131A",
        "950": "#0A0D12",
        "1000": "#05070A"
      },
      "blue": {
        "50": "#EAF2FF",
        "100": "#D3E4FF",
        "200": "#A9CBFF",
        "300": "#7DB0FF",
        "400": "#4F93FF",
        "500": "#2B7BFF",
        "600": "#1466F0",
        "700": "#0E52C4",
        "800": "#0C4199",
        "900": "#0A3272"
      },
      "cyanGlow": {
        "300": "#8CE0FF",
        "400": "#4FC8FF",
        "500": "#22B3FF"
      },
      "green": { "400": "#34D399", "500": "#10B981", "600": "#059669" },
      "amber": { "400": "#FBBF24", "500": "#F59E0B", "600": "#D97706" },
      "red":   { "400": "#F87171", "500": "#EF4444", "600": "#DC2626" },
      "violet":{ "400": "#A78BFA", "500": "#8B5CF6", "600": "#7C3AED" },
      "teal":  { "400": "#2DD4BF", "500": "#14B8A6", "600": "#0D9488" }
    },

    "semantic": {
      "dark": {
        "bg": {
          "canvas": "{color.primitive.graphite.950}",
          "base": "{color.primitive.graphite.900}",
          "subtle": "{color.primitive.graphite.850}",
          "surface": "{color.primitive.graphite.800}",
          "raised": "{color.primitive.graphite.750}",
          "overlay": "{color.primitive.graphite.700}",
          "inset": "{color.primitive.graphite.1000}",
          "hover": "rgba(255,255,255,0.04)",
          "active": "rgba(255,255,255,0.08)",
          "selected": "rgba(43,123,255,0.14)"
        },
        "text": {
          "primary": "{color.primitive.graphite.50}",
          "secondary": "{color.primitive.graphite.300}",
          "tertiary": "{color.primitive.graphite.400}",
          "disabled": "{color.primitive.graphite.600}",
          "inverse": "{color.primitive.graphite.950}",
          "onAccent": "#FFFFFF",
          "link": "{color.primitive.blue.400}"
        },
        "border": {
          "subtle": "rgba(255,255,255,0.06)",
          "default": "rgba(255,255,255,0.10)",
          "strong": "rgba(255,255,255,0.16)",
          "focus": "{color.primitive.blue.400}",
          "inset": "rgba(0,0,0,0.40)"
        },
        "accent": {
          "solid": "{color.primitive.blue.500}",
          "solidHover": "{color.primitive.blue.400}",
          "solidActive": "{color.primitive.blue.600}",
          "soft": "rgba(43,123,255,0.16)",
          "softHover": "rgba(43,123,255,0.24)",
          "text": "{color.primitive.blue.300}",
          "ring": "rgba(43,123,255,0.45)",
          "glow": "rgba(79,200,255,0.35)"
        },
        "status": {
          "success": "{color.primitive.green.400}",
          "successSoft": "rgba(52,211,153,0.14)",
          "warning": "{color.primitive.amber.400}",
          "warningSoft": "rgba(251,191,36,0.14)",
          "danger": "{color.primitive.red.400}",
          "dangerSoft": "rgba(248,113,113,0.14)",
          "info": "{color.primitive.blue.400}",
          "infoSoft": "rgba(79,147,255,0.14)"
        },
        "ai": {
          "aura": "{color.primitive.cyanGlow.400}",
          "auraSoft": "rgba(79,200,255,0.12)",
          "gradientFrom": "#2B7BFF",
          "gradientTo": "#4FC8FF",
          "listening": "{color.primitive.cyanGlow.400}",
          "thinking": "{color.primitive.violet.400}",
          "speaking": "{color.primitive.blue.400}"
        }
      },

      "light": {
        "bg": {
          "canvas": "{color.primitive.graphite.50}",
          "base": "{color.primitive.graphite.0}",
          "subtle": "{color.primitive.graphite.25}",
          "surface": "{color.primitive.graphite.0}",
          "raised": "{color.primitive.graphite.0}",
          "overlay": "{color.primitive.graphite.0}",
          "inset": "{color.primitive.graphite.100}",
          "hover": "rgba(15,19,26,0.04)",
          "active": "rgba(15,19,26,0.07)",
          "selected": "rgba(20,102,240,0.10)"
        },
        "text": {
          "primary": "{color.primitive.graphite.900}",
          "secondary": "{color.primitive.graphite.600}",
          "tertiary": "{color.primitive.graphite.500}",
          "disabled": "{color.primitive.graphite.300}",
          "inverse": "{color.primitive.graphite.0}",
          "onAccent": "#FFFFFF",
          "link": "{color.primitive.blue.600}"
        },
        "border": {
          "subtle": "rgba(15,19,26,0.06)",
          "default": "rgba(15,19,26,0.10)",
          "strong": "rgba(15,19,26,0.16)",
          "focus": "{color.primitive.blue.600}",
          "inset": "rgba(15,19,26,0.06)"
        },
        "accent": {
          "solid": "{color.primitive.blue.600}",
          "solidHover": "{color.primitive.blue.500}",
          "solidActive": "{color.primitive.blue.700}",
          "soft": "rgba(20,102,240,0.10)",
          "softHover": "rgba(20,102,240,0.16)",
          "text": "{color.primitive.blue.700}",
          "ring": "rgba(20,102,240,0.35)",
          "glow": "rgba(43,123,255,0.25)"
        },
        "status": {
          "success": "{color.primitive.green.600}",
          "successSoft": "rgba(16,185,129,0.12)",
          "warning": "{color.primitive.amber.600}",
          "warningSoft": "rgba(245,158,11,0.12)",
          "danger": "{color.primitive.red.600}",
          "dangerSoft": "rgba(239,68,68,0.10)",
          "info": "{color.primitive.blue.600}",
          "infoSoft": "rgba(20,102,240,0.10)"
        },
        "ai": {
          "aura": "{color.primitive.blue.500}",
          "auraSoft": "rgba(43,123,255,0.10)",
          "gradientFrom": "#1466F0",
          "gradientTo": "#22B3FF",
          "listening": "{color.primitive.cyanGlow.500}",
          "thinking": "{color.primitive.violet.600}",
          "speaking": "{color.primitive.blue.600}"
        }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": "\"Geist\", \"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "display": "\"Geist\", \"Space Grotesk\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"Geist Mono\", \"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
      "numeric": "\"Geist\", \"Inter\", sans-serif"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tighter": "-0.03em",
      "tight": "-0.015em",
      "normal": "0em",
      "wide": "0.02em",
      "wider": "0.06em"
    },
    "lineHeight": {
      "none": "1",
      "tight": "1.15",
      "snug": "1.35",
      "normal": "1.5",
      "relaxed": "1.65"
    },
    "scale": {
      "displayXl": { "size": "48px", "lineHeight": "1.05", "weight": 600, "tracking": "-0.03em" },
      "displayLg": { "size": "38px", "lineHeight": "1.08", "weight": 600, "tracking": "-0.03em" },
      "displayMd": { "size": "30px", "lineHeight": "1.15", "weight": 600, "tracking": "-0.02em" },
      "h1": { "size": "24px", "lineHeight": "1.2", "weight": 600, "tracking": "-0.02em" },
      "h2": { "size": "20px", "lineHeight": "1.25", "weight": 600, "tracking": "-0.015em" },
      "h3": { "size": "17px", "lineHeight": "1.3", "weight": 600, "tracking": "-0.01em" },
      "bodyLg": { "size": "16px", "lineHeight": "1.55", "weight": 400, "tracking": "0em" },
      "body": { "size": "14px", "lineHeight": "1.55", "weight": 400, "tracking": "0em" },
      "bodySm": { "size": "13px", "lineHeight": "1.5", "weight": 400, "tracking": "0em" },
      "label": { "size": "13px", "lineHeight": "1.3", "weight": 500, "tracking": "0em" },
      "caption": { "size": "12px", "lineHeight": "1.35", "weight": 500, "tracking": "0.01em" },
      "overline": { "size": "11px", "lineHeight": "1.3", "weight": 600, "tracking": "0.06em", "transform": "uppercase" },
      "mono": { "size": "13px", "lineHeight": "1.5", "weight": 400, "tracking": "0em" }
    }
  },

  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0px",
      "0.5": "2px",
      "1": "4px",
      "1.5": "6px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "7": "28px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "14": "56px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px"
    },
    "density": {
      "compact": { "rowHeight": "32px", "controlHeight": "30px", "paddingX": "8px", "paddingY": "6px", "gap": "8px" },
      "comfortable": { "rowHeight": "44px", "controlHeight": "40px", "paddingX": "16px", "paddingY": "12px", "gap": "16px" }
    }
  },

  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "3xl": "28px",
    "pill": "9999px",
    "role": {
      "control": "8px",
      "input": "8px",
      "card": "16px",
      "panel": "20px",
      "modal": "20px",
      "sheet": "24px",
      "popover": "12px",
      "chip": "9999px",
      "avatar": "9999px"
    }
  },

  "elevation": {
    "dark": {
      "0": { "z": 0, "shadow": "none", "surface": "{color.primitive.graphite.900}" },
      "1": { "z": 1, "shadow": "0 1px 2px rgba(0,0,0,0.40)", "surface": "{color.primitive.graphite.850}" },
      "2": { "z": 10, "shadow": "0 4px 12px rgba(0,0,0,0.45)", "surface": "{color.primitive.graphite.800}" },
      "3": { "z": 100, "shadow": "0 12px 32px rgba(0,0,0,0.50)", "surface": "{color.primitive.graphite.750}" },
      "4": { "z": 1000, "shadow": "0 24px 64px rgba(0,0,0,0.60)", "surface": "{color.primitive.graphite.700}" }
    },
    "light": {
      "0": { "z": 0, "shadow": "none", "surface": "{color.primitive.graphite.0}" },
      "1": { "z": 1, "shadow": "0 1px 2px rgba(15,19,26,0.06)", "surface": "{color.primitive.graphite.0}" },
      "2": { "z": 10, "shadow": "0 4px 12px rgba(15,19,26,0.08)", "surface": "{color.primitive.graphite.0}" },
      "3": { "z": 100, "shadow": "0 12px 32px rgba(15,19,26,0.12)", "surface": "{color.primitive.graphite.0}" },
      "4": { "z": 1000, "shadow": "0 24px 64px rgba(15,19,26,0.16)", "surface": "{color.primitive.graphite.0}" }
    }
  },

  "shadow": {
    "focusRing": {
      "dark": "0 0 0 2px {color.semantic.dark.bg.canvas}, 0 0 0 4px {color.semantic.dark.accent.ring}",
      "light": "0 0 0 2px {color.semantic.light.bg.base}, 0 0 0 4px {color.semantic.light.accent.ring}"
    },
    "aiGlow": {
      "sm": "0 0 12px rgba(79,200,255,0.30)",
      "md": "0 0 24px rgba(79,200,255,0.35)",
      "lg": "0 0 48px rgba(79,200,255,0.40)"
    },
    "innerTop": "inset 0 1px 0 rgba(255,255,255,0.06)"
  },

  "blur": {
    "none": "0px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "40px"
  },

  "opacity": {
    "disabled": 0.4,
    "muted": 0.6,
    "scrim": 0.6,
    "hover": 0.08,
    "pressed": 0.12
  },

  "border": {
    "width": { "hairline": "0.5px", "thin": "1px", "thick": "1.5px", "heavy": "2px" }
  },

  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "320ms",
      "slower": "480ms",
      "ambient": "2400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "linear": "linear"
    },
    "distance": { "sm": "4px", "md": "8px", "lg": "16px" }
  },

  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "sidebar": 200,
    "topbar": 210,
    "dropdown": 300,
    "popover": 400,
    "tooltip": 500,
    "drawer": 600,
    "modal": 700,
    "commandPalette": 800,
    "toast": 900,
    "voiceOverlay": 950,
    "max": 9999
  },

  "breakpoints": {
    "xs": "0px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "3xl": "1920px"
  },

  "grid": {
    "columns": { "xs": 4, "sm": 8, "md": 8, "lg": 12, "xl": 12, "2xl": 12 },
    "gutter": { "xs": "16px", "md": "20px", "lg": "24px" },
    "margin": { "xs": "16px", "md": "24px", "lg": "32px" },
    "maxContentWidth": "1440px"
  },

  "layout": {
    "sidebar": { "expanded": "260px", "collapsed": "64px", "rail": "56px" },
    "topbar": { "height": "56px" },
    "commandBar": { "height": "52px" },
    "rightPanel": { "default": "360px", "wide": "440px" },
    "chatComposer": { "minHeight": "56px", "maxHeight": "220px" }
  },

  "size": {
    "icon": { "xs": "14px", "sm": "16px", "md": "20px", "lg": "24px", "xl": "32px" },
    "avatar": { "xs": "20px", "sm": "28px", "md": "36px", "lg": "48px", "xl": "72px" },
    "control": { "sm": "30px", "md": "36px", "lg": "44px" }
  },

  "iconography": {
    "library": "lucide-react",
    "strokeWidth": { "default": 1.75, "bold": 2, "hairline": 1.5 },
    "defaultSize": "20px",
    "opticalAlignment": "center"
  }
}
